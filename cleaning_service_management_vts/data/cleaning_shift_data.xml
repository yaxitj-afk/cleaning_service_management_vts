<odoo>
    <data noupdate="1">

        <!-- Morning Shift -->
        <record id="shift_morning_vts" model="cleaning.shift.vts">
            <field name="name">Morning Shift</field>
            <field name="start_time">8.0</field>
            <field name="end_time">12.0</field>
            <field name="note">Standard morning cleaning shift</field>
        </record>

        <!-- Afternoon Shift -->
        <record id="shift_afternoon_vts" model="cleaning.shift.vts">
            <field name="name">Afternoon Shift</field>
            <field name="start_time">12.0</field>
            <field name="end_time">16.0</field>
            <field name="note">Post-lunch cleaning shift</field>
        </record>

        <!-- Evening Shift -->
        <record id="shift_evening_vts" model="cleaning.shift.vts">
            <field name="name">Evening Shift</field>
            <field name="start_time">16.0</field>
            <field name="end_time">20.0</field>
            <field name="note">Evening maintenance shift</field>
        </record>

        <!-- Night Shift -->
        <record id="shift_night_vts" model="cleaning.shift.vts">
            <field name="name">Night Shift</field>
            <field name="start_time">20.0</field>
            <field name="end_time">24.0</field>
            <field name="note">Night cleaning for hospitals and offices</field>
        </record>

        <!-- Full Day Shift -->
        <record id="shift_full_day_vts" model="cleaning.shift.vts">
            <field name="name">Full Day (8 Hours)</field>
            <field name="start_time">9.0</field>
            <field name="end_time">17.0</field>
            <field name="note">Standard 8-hour working shift</field>
        </record>

    </data>
</odoo>