<odoo>
    <record id="email_template_cleaning_booking_approved_vts" model="mail.template">
        <field name="name">Cleaning Booking Approved</field>
        <field name="model_id" ref="cleaning_service_management_vts.model_booking_request"/>
        <field name="subject">Booking Approved - {{ object.name }}</field>
        <field name="email_from">{{ user.email or object.company_id.email }}</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="body_html" type="html">

            <![CDATA[
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333;">

                    <p>Dear <strong>{{ object.partner_id.name }}</strong>,</p>

                    <p>
                        We’re pleased to inform you that your <strong>cleaning booking has been approved</strong>.
                    </p>

                    <p><strong>Booking Details:</strong></p>

                    <table style="border-collapse: collapse; width: 100%; margin-top: 10px;">
                        <tr>
                            <td><strong>Reference:</strong></td>
                            <td>{{ object.name }}</td>
                        </tr>
                        <tr>
                            <td><strong>Service:</strong></td>
                            <td>{{ object.service_type_id.name or '' }}</td>
                        </tr>
                        <tr>
                            <td><strong>Date:</strong></td>
                            <td>{{ object.preferred_date or '' }}</td>
                        </tr>
                        <tr>
                            <td><strong>Address:</strong></td>
                            <td>{{ object.address or '' }}, {{ object.city or '' }}</td>
                        </tr>
                        <tr>
                            <td><strong>Area:</strong></td>
                            <td>{{ object.area_sqft or 0 }} sq.ft</td>
                        </tr>
                    </table>

                    % if object.is_recurring:
                    <p>
                        <strong>Recurring Plan:</strong>
                        Every {{ object.repeat_interval }} {{ object.recurring_type }}
                        starting from {{ object.start_recurring_date }}.
                    </p>
                    % endif

                    <p style="margin-top: 15px;">
                        Our team will arrive as scheduled and ensure quality service.
                    </p>

                    <p style="margin-top: 20px;">
                        Thank you for choosing us.
                    </p>

                    <p>
                        Best regards,<br/>
                        <strong>{{ user.name }}</strong>
                    </p>

                </div>
                                ]]>
        </field>
    </record>
</odoo>