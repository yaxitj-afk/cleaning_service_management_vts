<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="cleaning_form_template" name="Cleaning Service Form">
            <t t-call="website.layout">
                <div class="wrap cleaning-bg-card">
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-lg-8 mt-5 mb-5">

                                <div class="card shadow-lg border-0 rounded-4 cleaning-form-card">
                                    <div class="card-body p-4">

                                        <h2 class="text-center mb-4 fw-bold">
                                            Book Cleaning Service
                                        </h2>

                                        <form action="/cleaning/submit" method="post">
                                            <input type="hidden" name="csrf_token"
                                                   t-att-value="request.csrf_token()"/>

                                            <!-- Name -->
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Name</label>
                                                <input type="text" name="partner_name"
                                                       class="form-control form-control-lg"
                                                       t-att-value="partner.name"/>
                                            </div>

                                            <!-- Service -->
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Service</label>
                                                <select name="service_type_id" class="form-select form-select-lg">
                                                    <t t-foreach="services" t-as="s">
                                                        <option t-att-value="s.id">
                                                            <t t-esc="s.name"/>
                                                        </option>
                                                    </t>
                                                </select>
                                            </div>

                                            <!-- Row Layout -->
                                            <div class="row">
                                                <div class="col-md-4 mb-3">
                                                    <label class="form-label">Floors</label>
                                                    <input type="number" name="floor_count"
                                                           class="form-control"/>
                                                </div>

                                                <div class="col-md-4 mb-3">
                                                    <label class="form-label">Rooms</label>
                                                    <input type="number" name="room_count"
                                                           class="form-control"/>
                                                </div>

                                                <div class="col-md-4 mb-3">
                                                    <label class="form-label">Area (sqft)</label>
                                                    <input type="number" name="area_sqft"
                                                           class="form-control"/>
                                                </div>
                                            </div>

                                            <!-- Shift + Date -->
                                            <div class="row">
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">Cleaning Shift</label>
                                                    <select name="cleaning_shift_id" class="form-select">
                                                        <t t-foreach="shifts" t-as="sh">
                                                            <option t-att-value="sh.id">
                                                                <t t-esc="sh.name"/>
                                                            </option>
                                                        </t>
                                                    </select>
                                                </div>

                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">Preferred Date</label>
                                                    <input type="date" name="preferred_date"
                                                           class="form-control" required="1"/>
                                                </div>
                                            </div>

                                            <!-- Recurring Section -->
                                            <div class="border rounded-3 p-3 mt-3">
                                                <div class="form-check mb-2">
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           id="is_recurring"
                                                           name="is_recurring"/>
                                                    <label class="form-check-label fw-semibold">
                                                        Recurring Service
                                                    </label>
                                                </div>

                                                <div id="recurring_fields" style="display:none;">
                                                    <div class="row mt-2">
                                                        <div class="col-md-6 mb-3">
                                                            <label class="form-label">Repeat Every</label>
                                                            <input type="number"
                                                                   name="repeat_interval"
                                                                   class="form-control"/>
                                                        </div>

                                                        <div class="col-md-6 mb-3">
                                                            <label class="form-label">Type</label>
                                                            <select name="recurring_type"
                                                                    class="form-select">
                                                                <option value="day">Daily</option>
                                                                <option value="week">Weekly</option>
                                                                <option value="month">Monthly</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Instructions -->
                                            <div class="mt-3">
                                                <label class="form-label">Instructions</label>
                                                <textarea name="special_instructions"
                                                          class="form-control"
                                                          rows="3"/>
                                            </div>

                                            <!-- Submit -->
                                            <div class="text-center mt-4">
                                                <button type="submit"
                                                        class="btn btn-submit btn-lg px-5 rounded-pill">
                                                    Submit Request
                                                </button>
                                            </div>

                                        </form>

                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

            </t>
        </template>

        <template id="cleaning_thank_you" name="Cleaning Thank You Page">
            <t t-call="website.layout">
                <div class="container text-center mt-5 mb-5">
                    
                    <h1 class="text-success">Thank You!</h1>

                    <p class="lead mt-3">
                        Your cleaning service request has been submitted successfully.
                    </p>

                    <p>
                        We will get back to you shortly.
                    </p>

                    <a href="/" class="btn btn-primary mt-4">
                        Go to Homepage
                    </a>

                </div>
            </t>
        </template>
    </data>
</odoo>