<odoo>
    <!-- list VIEW -->
    <record id="view_booking_request_list_vts" model="ir.ui.view">
        <field name="name">booking.request.list</field>
        <field name="model">booking.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="mobile"/>
                <field name="area_sqft"/>
                <field name="preferred_date"/>
                <field name="pricing_type"/>
                <field name="estimated_amount"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       decoration-warning="state == 'under_review'" decoration-info="state == 'submitted'"
                       decoration-muted="state == 'draft'"
                       statusbar_visible="draft,submitted,under_review,approved,rejected"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_booking_request_form_vts" model="ir.ui.view">
        <field name="name">booking.request.form</field>
        <field name="model">booking.request</field>
        <field name="arch" type="xml">
            <form string="Cleaning Booking Request">

                <!-- HEADER -->
                <header>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft"
                            invisible="state != 'under_review' and state != 'approved'"/>

                    <button name="action_review" type="object"
                            string="Mark Review"
                            invisible="state != 'draft'"/>

                    <button name="action_approve" type="object"
                            string="Approve"
                            invisible="state != 'under_review'"
                            class="btn-success"/>

                    <button name="action_reject" type="object"
                            string="Reject"
                            invisible="state != 'under_review'"
                            class="btn-danger"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,under_review,approved,rejected"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_booking_task"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-tasks">

                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Tasks</span>
                                <span class="o_stat_value">
                                    <field name="cln_task_count"/>
                                </span>
                            </div>

                        </button>
                    </div>

                    <!-- TITLE -->
                    <div class="oe_title">
                        <h2>
                            <field name="name" readonly="1"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" required="1" readonly="state == 'under_review'"/>
                            <field name="mobile" readonly="state == 'under_review'"/>
                            <field name="email" readonly="state == 'under_review'"/>
                        </group>
                        <group>
                            <field name="service_type_id" required="1" readonly="state == 'under_review'"/>
                            <field name="floor_count" readonly="state == 'under_review'"/>
                            <field name="area_sqft" readonly="state == 'under_review'"/>
                            <field name="room_count" readonly="state == 'under_review'"/>
                        </group>
                    </group>

                    <notebook>

                        <!-- 2. ADDRESS & SCHEDULE-->
                        <page string="Address and Schedule">
                            <group>
                                <group>
                                    <field name="address" required="1" readonly="state == 'under_review'"/>
                                    <field name="pincode" readonly="state == 'under_review'"/>
                                    <field name="city" required="1" readonly="state == 'under_review'"/>
                                    <field name="state_id" readonly="state == 'under_review'"/>
                                    <field name="country_id" readonly="state == 'under_review'"/>
                                </group>

                                <group>
                                    <field name="preferred_date" readonly="state == 'under_review'" required="1"/>
                                    <field name="preferred_time" readonly="state == 'under_review'"/>
                                    <field name="cleaning_shift_id" readonly="state == 'under_review'" required="1"/>
                                    <field name="is_individual" readonly="state == 'under_review'"/>
                                    <field name="individual_id" invisible="not is_individual"
                                           readonly="state == 'under_review'"/>
                                    <field name="cleaning_team_id"
                                           domain="[('cleaning_shift_id', '=', cleaning_shift_id)]"
                                           invisible="is_individual" readonly="state == 'under_review'"/>
                                </group>
                            </group>
                        </page>

                        <!-- 3. PRICING & RECURRING-->
                        <page string="Pricing and Recurring">
                            <group>
                                <group>
                                    <field name="pricing_type" readonly="state == 'under_review'"/>
                                    <field name="fixed_price" invisible="pricing_type != 'fixed'"
                                           readonly="state == 'under_review'"/>
                                    <field name="rate_per_sqft" invisible="pricing_type != 'area_based'"
                                           readonly="state == 'under_review'"/>
                                    <field name="estimated_amount" readonly="1"/>
                                </group>

                                <group>
                                    <field name="is_recurring" readonly="state == 'under_review'"/>
                                    <div invisible="not is_recurring" class="o_row">
                                        <span class="o_form_label me-2">Repeat</span>
                                        <field name="repeat_interval" class="oe_inline me-2" style="width: 70px;"
                                               readonly="state == 'under_review'"/>
                                        <field name="recurring_type" class="oe_inline"
                                               readonly="state == 'under_review'"/>
                                    </div>
                                    <field name="start_recurring_date" invisible="not is_recurring"
                                           readonly="state == 'under_review'"/>
                                </group>
                            </group>
                        </page>

                        <!--4. MANAGEMENT & NOTES-->
                        <page string="Management and Notes">
                            <group>
                                <group>
                                    <field name="assigned_manager_id" required="1" readonly="state == 'under_review'"/>
                                    <field name="approved_on" readonly="1"/>
                                    <field name="rejected_on" readonly="1"/>
                                </group>

                                <group>
                                    <field name="special_instructions" readonly="state == 'under_review'"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <record id="seq_booking_request" model="ir.sequence">
        <field name="name">Booking Request</field>
        <field name="code">cleaning.booking.request</field>
        <field name="prefix">BR/</field>
        <field name="padding">5</field>
    </record>

    <!-- ACTION-->
    <record id="action_booking_request" model="ir.actions.act_window">
        <field name="name">Booking Requests</field>
        <field name="res_model">booking.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENU -->
    <menuitem id="menu_cleaning_root"
              name="Cleaning"
              sequence="1"/>

    <menuitem id="menu_booking_request"
              name="Booking Requests"
              parent="menu_cleaning_root"
              action="action_booking_request"
              sequence="10"/>

</odoo>