<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_availability_checker_form_vts" model="ir.ui.view">
        <field name="name">empl.availability.vts.form</field>
        <field name="model">empl.availability.vts</field>
        <field name="arch" type="xml">
            <form string="Check Availability" create="false" edit="true" duplicate="false" delete="false">
                <sheet>

                    <!-- ── Page Header Banner ── -->
                    <div style="
                        background: #714B67;
                        border-radius: 10px;
                        padding: 20px 28px;
                        margin-bottom: 20px;
                        display: flex;
                        align-items: center;
                        gap: 16px;
                    ">
                        <span style="font-size:36px;">🗓️</span>
                        <div>
                            <div style="font-size:18px; font-weight:700; color:white;">
                                Check Availability
                            </div>
                            <div style="font-size:12px; color:rgba(255,255,255,0.8); margin-top:4px;">
                                Select a date, shift and time slot to find available employees and teams
                            </div>
                        </div>
                    </div>

                    <!-- ── Search Criteria ── -->
                    <div style="
                        background: white;
                        border: 1px solid #e0e0e0;
                        border-radius: 10px;
                        padding: 20px 24px;
                        margin-bottom: 16px;
                    ">
                        <div style="
                            font-size: 15px;
                            font-weight: 700;
                            color:  #714B67;
                            text-transform: uppercase;
                            letter-spacing: 1px;
                            margin-bottom: 16px;
                            border-bottom: 1px solid #e8eaf6;
                            padding-bottom: 8px;
                        ">🔍 Search Criteria
                        </div>

                        <group col="3">
                            <field name="check_date"/>
                            <field name="cleaning_shift_id"/>
                            <field name="shift_slot_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>

                        <div style="text-align:center; margin-top:16px;">
                            <button name="action_check_availability"
                                    type="object"
                                    string="Check Availability"
                                    class="btn btn-primary"
                                    style="padding: 10px 40px; font-size:14px; font-weight:600;"/>
                        </div>
                    </div>

                    <!-- ── Summary Box ── -->
                    <div invisible="not result_summary"
                         style="
                            background: #e8f5e9;
                            border: 1.5px solid #a5d6a7;
                            border-radius: 10px;
                            padding: 16px 24px;
                            margin-bottom: 16px;
                         ">
                        <div style="
                            font-size: 15px;
                            font-weight: 700;
                            color: #2e7d32;
                            text-transform: uppercase;
                            letter-spacing: 1px;
                            margin-bottom: 10px;
                        ">📊 Result Summary
                        </div>
                        <field name="result_summary"
                               nolabel="1"
                               readonly="1"
                               widget="text"
                               style="background:transparent; border:none; color:#2e7d32; font-weight:500;"/>
                    </div>

                    <!-- ── Results Tabs ── -->
                    <notebook invisible="not result_summary">

                        <page string="Available Employees" name="available_employees">
                            <field name="available_employee_ids" readonly="1" nolabel="1">
                                <list decoration-success="task_count == 0"
                                      decoration-warning="task_count > 0">
                                    <field name="name"/>
                                    <field name="job_id" string="Position"/>
                                    <field name="mobile_phone" string="Mobile"/>
                                    <field name="cleaning_shift_ids"
                                           widget="many2many_tags"
                                           string="Assigned Shifts"/>
                                    <field name="task_count" string="Active Tasks"/>
                                </list>
                            </field>
                        </page>

                        <page string="Available Teams" name="available_teams">
                            <field name="available_team_ids" readonly="1" nolabel="1">
                                <list>
                                    <field name="name" string="Team Name"/>
                                    <field name="cleaning_shift_id" string="Shift"/>
                                    <field name="employee_ids"
                                           widget="many2many_tags"
                                           string="Team Members"/>
                                </list>
                            </field>
                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_availability_checker_vts" model="ir.actions.act_window">
        <field name="name">Check Availability</field>
        <field name="res_model">empl.availability.vts</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="availability_checker_singleton"/>
    </record>

    <menuitem id="menu_availability_checker_vts"
              name="Check Availability"
              parent="menu_cleaning_root"
              action="action_availability_checker_vts"
              sequence="22"/>

</odoo>